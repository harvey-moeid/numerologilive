# Salin ke .env untuk pengembangan lokal (Render pakai Environment Variables di dashboard)
TIKTOK_USERNAME=namaakuntiktok
ADMIN_TOKEN=ganti-dengan-token-rahasia
PORT=3000

# Wajib untuk koneksi yang stabil ke TikTok Live. Tanpa ini, koneksi memakai
# tier gratis EulerStream yang sangat dibatasi dan sering gagal dengan error
# "Failed to sign request" (403). Daftar key gratis di https://www.eulerstream.com
SIGN_API_KEY=

# Ambang batas pemicu pembacaan numerologi (opsional, boleh dihapus untuk pakai default)
GIFT_MIN_COINS=1
LIKE_THRESHOLD=400
